class BaseCallExpr {
    val f_name =
        group(
            group(
                if
                    this_node.parent is BinOp
                    | LogicAssign
                    | LogicPredicate
                    | LogicUnify
                then
                    indent(
                        if
                            this_field is DotExpr
                            | KeepExpr
                            | CastExpr
                            | CallExpr
                        then recurse_flatten
                        else recurse
                    )
                else
                    if this_field is DotExpr | KeepExpr | CastExpr | CallExpr
                    then recurse_flatten
                    else recurse,
                id="name"
            )
        )
}

