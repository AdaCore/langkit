                case ArrayLiteral | BlockExpr | ParenExpr | MatchExpr =>
                    ["=", whitespace, recurse(f_expr)]
                case _ => group(indent("=", line, recurse(f_expr)))
            }
        )
    val f_decl_type = [":", whitespace, recurse]
}

class VarBind {
    val node =
        group(
            "bind",
            recurse(f_name),
            whitespace,
            match this_node.f_expr {
                case ArrayLiteral | BlockExpr | ParenExpr | MatchExpr =>
                    ["=", whitespace, recurse(f_expr)]
                case _ => group(indent("=", line, recurse(f_expr)))
            }
        )
}
