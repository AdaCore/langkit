class LogicAssign {
    val node =
        if this_node.parent is BinOp
        then
            group(
                indent(
                    recurse(f_dest_var),
                    line,
                    "<-",
                    whitespace,
                    if
                        this_node.f_value is ArrayLiteral
                        | BaseCallExpr
                        | MatchExpr
                    then recurse(f_value)
                    else
                        indent(recurse(f_value), bubbleUpTrailingTrivias=true),
                    bubbleUpTrailingTrivias=true
                )
            )
        else
            group(
                recurse(f_dest_var),
                line,
                "<-",
                whitespace,
                if this_node.f_value is ArrayLiteral | BaseCallExpr | MatchExpr
                then recurse(f_value)
                else indent(recurse(f_value), bubbleUpTrailingTrivias=true)
            )
}

class LogicExpr {
}

class LogicPredicate {
    val node =
        group(
            recurse(f_name),
            "%",
            "(",
            if this_node.f_args.is_empty then recurse(f_args)
            elif
                this_node.parent is BinOp
                | LogicAssign
                | LogicPredicate
                | LogicUnify
            then
                ifBreak(
                    group(indent(indent(softline, recurse(f_args)), softline)),
                    group(indent(softline, recurse(f_args)), softline),
                    groupId="name"
                )
            else group(indent(softline, recurse(f_args)), softline),
            ")"
        )
}

class LogicPropagate {
    val node =
        if this_node.parent is BinOp
        then
            group(
                indent(
                    recurse(f_dest_var),
                    line,
                    "<-",
                    whitespace,
                    recurse(f_call),
                    bubbleUpTrailingTrivias=true
                )
            )
        else
            group(recurse(f_dest_var), line, "<-", whitespace, recurse(f_call))
}

class LogicPropagateCall {
    val node =
        group(
            recurse(f_name),
            "%",
            "(",
            if this_node.f_args.is_empty then recurse(f_args)
            elif
                this_node.parent is BinOp
                | LogicAssign
                | LogicPredicate
                | LogicUnify
            then
                ifBreak(
                    group(indent(indent(softline, recurse(f_args)), softline)),
                    group(indent(softline, recurse(f_args)), softline),
                    groupId="name"
                )
            else group(indent(softline, recurse(f_args)), softline),
            ")"
        )
}

class LogicUnify {
    val node =
        if this_node.parent is BinOp
        then
            group(
                indent(
                    recurse(f_lhs),
                    line,
                    "<->",
                    whitespace,
                    if
                        this_node.f_rhs is ArrayLiteral
                        | BaseCallExpr
                        | MatchExpr
                    then recurse(f_rhs)
                    else indent(recurse(f_rhs), bubbleUpTrailingTrivias=true),
                    bubbleUpTrailingTrivias=true
                )
            )
        else
            group(
                recurse(f_lhs),
                line,
                "<->",
                whitespace,
                if this_node.f_rhs is ArrayLiteral | BaseCallExpr | MatchExpr
                then recurse(f_rhs)
                else indent(recurse(f_rhs), bubbleUpTrailingTrivias=true)
            )
}

