val v1 = n is T
val v2 = n is T1 | T2
val v3 =
    n is Aaaaaaaaaaaaaaaaaaaa
    | Bbbbbbbbbbbbbbbbbbb
    | Cccccccccccccccc
    | Dddddddddddddddd
    | Eeeeeeeeeeee

val in_broken =
    foo(
        foo is A | B,
        aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,
        bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
    )

val with_comments =
    # Comment 1
    n is
    # Comment 2
    Aaaaaaaaaaaaaaaaaaaa
    | Bbbbbbbbbbbbbbbbbbb
    # Comment 3
    | Cccccccccccccccc
    | Dddddddddddddddd
    | Eeeeeeeeeeee

val in_binop =
    n is Aaaaaaaaaaaaaaaaaaaa
    | Bbbbbbbbbbbbbbbbbbb
    | Cccccccccccccccc
    | Dddddddddddddddd
    | Eeeeeeeeeeee
    and n.parent is Aaaaaaaaaaaaaaaaaaaa
    | Bbbbbbbbbbbbbbbbbbb
    | Cccccccccccccccc
    | Dddddddddddddddd
    | Eeeeeeeeeeee
