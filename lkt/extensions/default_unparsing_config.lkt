class CallExpr {
    val node =
        group(
            recurse(f_name),
            "(",
            if this_node.f_args.is_empty then recurse(f_args)
            elif
                this_node.parent is BinOp
                | LogicAssign
                | LogicPredicate
                | LogicUnify
            then
                ifBreak(
                    group(indent(indent(softline, recurse(f_args)), softline)),
                    group(indent(softline, recurse(f_args)), softline),
                    groupId="name"
                )
            else group(indent(softline, recurse(f_args)), softline),
            ")"
        )
}

