from lexer_example import foo_lexer

@with_lexer(foo_lexer)
grammar foo_grammar {
    @main_rule main_rule <- ExampleUnit(list+(example))
    example <- Example("example")
}

class FooNode implements Node[FooNode] {
}

class ExampleUnit: FooNode {
    @parse_field
    examples: ASTList[Example]

    @memoized
    fun entities_set(): Set[Entity[Example]] = self.examples.to_set()

    @exported
    fun has(e: Entity[Example]): Bool = self.entities_set().contains(e)

    @exported
    fun count(): Int = self.entities_set().length()

    @exported
    fun is_eq(other: Array[Entity[Example]]): Bool =
        self.entities_set() == other.to_set()

    @exported
    fun image_count(): Int = {
        val tmp = self.examples.map((x) => x.text).to_set();
        tmp.length()
    }

    # Make sure code generation is valid when a set type
    # (Set[Array[Int]) depends on an array type (Array[Int]).

    @memoized
    fun int_arrays(i: Int): Array[Array[Int]] =
        if i == 0
        then []: Array[Int]
        else {
            val prev = self.int_arrays(i - 1);
            prev & [prev.at(-1) & [i]]
        }

    @memoized
    @ignored
    fun int_array_set(i: Int): Set[Array[Int]] =
        self.int_arrays(i).to_set()
}

class Example: FooNode {
}

