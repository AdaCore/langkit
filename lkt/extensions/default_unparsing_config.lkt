class LambdaExpr {
    val node = [
        "(",
        recurse(f_params),
        ")",
        recurse(f_return_type),
        whitespace,
        match this_node.f_body {
            case ArrayLiteral | BlockExpr | ParenExpr | MatchExpr =>
                ["=>", whitespace, recurse(f_body)]
            case _ =>
                group(
                    indent(
                        "=>",
                        line,
                        flushLineBreaks,
                        match this_node.f_body {
                            case BlockExpr => [recurse(f_body)]
                            case _ => group(recurse(f_body))
                        }
                    ),
                    bubbleUpLeadingTrivias=false,
                    bubbleUpTrailingTrivias=false
                )
        }
    ]
    val f_params = group(indent(softline, recurse), softline)
    val f_return_type = [":", whitespace, recurse]
}

