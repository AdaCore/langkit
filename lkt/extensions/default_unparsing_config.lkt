            [
                "class",
                recurse(f_syn_name),
                recurse(f_syn_base_type),
                recurse(f_traits),
                if this_node.f_traits.is_empty then whitespace else [],
                "{"
            ]
        ),
        recurse(f_decls),
        "}"
    ]
    val f_syn_base_type = [":", whitespace, recurse]
    val f_traits = [indent([line, "implements", recurse]), line]
    val f_decls =
        if this_field.is_empty then [hardline, recurse]
        else [indent(hardline, recurse), hardline]
}

